# Copy to .env.local. Demo mode needs none of these.

# Turn on the Live switch (NEAR mainnet, real money).
KEYHOLE_LIVE=1
# Long random string: signs cookies and encrypts traders' NEAR Intents sign-ins.
KEYHOLE_SECRET=change-me
# Protects /api/cron/snapshot (keeps live records fresh).
CRON_SECRET=change-me
# Database: local file by default; hosted, a Turso (libSQL) database.
DATABASE_URL=file:keyhole.db
DATABASE_AUTH_TOKEN=
# Keys contract on NEAR mainnet (contracts/keys). Without it, key payments go straight to the trader.
KEYHOLE_KEYS_CONTRACT=
# Optional NEAR Intents partner key (lower fees). Set KEYHOLE_CONFIDENTIAL=1 only if NEAR enabled private quotes for it.
ONECLICK_API_KEY=
KEYHOLE_CONFIDENTIAL=
# Link shown in the footer.
NEXT_PUBLIC_REPO_URL=
